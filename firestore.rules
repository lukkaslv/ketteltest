rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidResult(data) {
      let hasBaseKeys = data.keys().hasAll(['userId', 'displayName', 'results', 'updatedAt', 'testType']);
      let validUserId = data.userId == request.auth.uid;
      let validDisplayName = data.displayName is string && data.displayName.size() <= 100;
      let validTestType = data.testType in ['bigfive', 'cattell', 'cattell_ka', 'attachment', 'attachment_ka'];
      
      let isBigFive = data.testType == 'bigfive' 
        && data.results.keys().hasAll(['O', 'C', 'E', 'A', 'N']);
        
      let isCattell = (data.testType == 'cattell' || data.testType == 'cattell_ka')
        && data.results.keys().hasAll(['A','B','C','E','F','G','H','I','L','M','N','O','Q1','Q2','Q3','Q4']);
        
      let isAttachment = (data.testType == 'attachment' || data.testType == 'attachment_ka')
        && data.results.keys().hasAll(['anxiety', 'avoidance']);

      return hasBaseKeys && validUserId && validDisplayName && validTestType && (isBigFive || isCattell || isAttachment);
    }

    match /results/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidResult(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
        && isValidId(userId)
        && userId == request.auth.uid
        && existing().userId == request.auth.uid
        && isValidResult(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'displayName', 'results', 'updatedAt', 'testType'])
        && incoming().updatedAt == request.time;
    }

    match /results/{userId}/history/{testId} {
      allow get, list: if isSignedIn() && isValidId(userId); // allow anyone signed in to see the history
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && isValidId(testId)
        && userId == request.auth.uid
        && isValidResult(incoming())
        && incoming().updatedAt == request.time;
    }
  }
}
